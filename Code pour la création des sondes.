import re


def analyse_transcripts():
# Partie 1: Création d'un fichier fasta avec tous les transcripts principaux
    transcripts_principaux = []

    # On récupère les transcripts principaux
    with open("gencode.v50.annotation.gtf", "r") as fichier:
        for ligne in fichier:
            # On garde uniquement les transcripts codant pour des protéines
            # et possédant le tag Ensembl_canonical
            if 'tag "Ensembl_canonical"' in ligne and "\ttranscript\t" in ligne and 'gene_type "protein_coding"' in ligne:
                resultat = re.search(r'transcript_id\s+"([^"]+)"', ligne)
                if resultat:
                    transcripts_principaux.append(resultat.group(1))
    transcripts_principaux = set(transcripts_principaux)

    # On crée un nouveau fichier contenant uniquement les transcripts sélectionnés
    with open("gencode.v50.transcripts.fa", "r") as fasta, \
         open("transcrits_principaux.fa", "w") as sortie:

        garder = False

        for ligne in fasta:
            ligne = ligne.strip()
            if ligne.startswith(">"):
                # On récupère l'identifiant du transcript dans l'en tête
                transcript_id = ligne[1:].split("|")[0]
                if transcript_id in transcripts_principaux:
                    garder = True
                    sortie.write(ligne + "\n")
                else:
                    garder = False
            elif garder:
                # On écrit la séquence si le transcript a été sélectionné
                sortie.write(ligne + "\n")

# Partie 2: Création d'un fichier fasta contenant les informations des sequences et des homopolymeres presents dans les sequencesz
    # On recherche maintenant les homopolymères dans les transcripts sélectionnés
    with open("transcrits_principaux.fa", "r") as fichier, \
         open("homopolymeres.fasta", "w") as sortie:

        transcript_id = None
        sequence = ""

        for ligne in fichier:
            if ligne.startswith(">"):
                # On traite le transcript précédent avant de passer au suivant
                if transcript_id is not None:
                    homopolymeres = []
                    # On recherche les suites d'au moins 5 nucléotides dans chaques sequences
                    for match in re.finditer(r"([ACGT])\1{4,}", sequence):
                        homopolymere = match.group(0)
                        # La position commence à 1 dans la séquence
                        position = match.start() + 1
                        homopolymeres.append((homopolymere, position))
                    # On écrit les informations du transcript
                    sortie.write(
                        ">" + transcript_id
                        + "|taille=" + str(len(sequence))
                        + "|homopolymeres=" + str(len(homopolymeres))
                        + "\n"
                    )
                    # On écrit chaque homopolymère avec sa position
                    for homopolymere, position in homopolymeres:
                        sortie.write(
                            homopolymere
                            + "|position=" + str(position)
                            + "\n"
                        )
                # On récupère l'identifiant du nouveau transcript
                transcript_id = ligne[1:].split("|")[0]
                sequence = ""
            else:
                # On rassemble les différentes lignes de la séquence
                sequence += ligne.strip()
        # On traite le dernier transcript du fichier
        if transcript_id is not None:
            homopolymeres = []
            for match in re.finditer(r"([ACGT])\1{4,}", sequence):
                homopolymere = match.group(0)
                position = match.start() + 1
                homopolymeres.append((homopolymere, position))

            sortie.write(
                ">" + transcript_id
                + "|taille=" + str(len(sequence))
                + "|homopolymeres=" + str(len(homopolymeres))
                + "\n"
            )

            for homopolymere, position in homopolymeres:
                sortie.write(
                    homopolymere
                    + "|position=" + str(position)
                    + "\n"
                )


