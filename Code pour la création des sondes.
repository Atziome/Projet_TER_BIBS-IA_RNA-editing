def creation_tab():
    # J'utilise la bibliothèque panda pour créer un tableau que je peux exporter sur excel 
    import pandas as pd

    # On initialise le tableau avec les differentes longueurs en index et une colonne pour chaque type de poly
    statistiques = pd.DataFrame(
        0,
        index=["5", "6", "7", "8", "9", ">=10"],
        columns=["polyA", "polyT", "polyG", "polyC"]
    )

    # On parcourt le fichier contenant les homopolymeres
    with open("homopolymeres.fasta", "r") as fichier:

        for ligne in fichier:

            # On passe les en-tetes des transcripts 
            if not ligne.startswith(">"):
                homopolymere= ligne.strip().split("|")[0]
                
                if homopolymere:
                    longueur= len(homopolymere)
                    nucleotide= homopolymere[0]
                    # On determine la categorie de longueur
                    if longueur >= 10:
                        categorie = "10+"
                    elif longueur >= 5:
                        categorie = str(longueur)
                    else:
                        continue
                    # On ajoute 1 dans la bonne case du tableau
                    colonne= "poly" + nucleotide
                    statistiques.loc[categorie, colonne] += 1

    # On ajoute le nom de l'index dans la premiere colonne 
    statistiques.index.name = "N"
    # On affiche le tableau dans le terminal
    print(statistiques)
    # On enregistre les resultats dans un fichier CSV pour utiliser sur excel
    statistiques.to_csv("statistiques_homopolymeres.csv")

